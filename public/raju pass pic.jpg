<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <radialGradient id="avatarBg" cx="50%" cy="35%" r="65%">
      <stop offset="0%" stopColor="#1a0a0f" />
      <stop offset="60%" stopColor="#0d0407" />
      <stop offset="100%" stopColor="#050102" />
    </radialGradient>

    <!-- Subtle Red Rim Light Gradient -->
    <linearGradient id="redRimLight" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#ff1f3d" stopOpacity="0.4" />
      <stop offset="50%" stopColor="#ff1f3d" stopOpacity="0.0" />
      <stop offset="100%" stopColor="#ff1f3d" stopOpacity="0.3" />
    </linearGradient>

    <!-- Skin Tone Gradients -->
    <linearGradient id="skinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stopColor="#cd9770" />
      <stop offset="60%" stopColor="#be8660" />
      <stop offset="100%" stopColor="#a96f4a" />
    </linearGradient>
    <linearGradient id="neckGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stopColor="#9a623f" />
      <stop offset="100%" stopColor="#824f31" />
    </linearGradient>

    <!-- Plaid Shirt Patterns -->
    <pattern id="plaidPattern" width="40" height="40" patternUnits="userSpaceOnUse">
      <rect width="40" height="40" fill="#a48d79" />
      <!-- Vertical Bands -->
      <rect x="0" y="0" width="14" height="40" fill="#58798e" fill-opacity="0.85" />
      <rect x="14" y="0" width="4" height="40" fill="#ffffff" fill-opacity="0.6" />
      <rect x="18" y="0" width="6" height="40" fill="#324754" fill-opacity="0.6" />
      <rect x="34" y="0" width="3" height="40" fill="#ffffff" fill-opacity="0.7" />
      <!-- Horizontal Bands -->
      <rect x="0" y="0" width="40" height="14" fill="#58798e" fill-opacity="0.85" />
      <rect x="0" y="14" width="40" height="4" fill="#ffffff" fill-opacity="0.6" />
      <rect x="0" y="18" width="40" height="6" fill="#324754" fill-opacity="0.6" />
      <rect x="0" y="34" width="40" height="3" fill="#ffffff" fill-opacity="0.7" />
    </pattern>

    <!-- Hair Texture Gradient -->
    <linearGradient id="hairGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#222026" />
      <stop offset="50%" stopColor="#141317" />
      <stop offset="100%" stopColor="#0a0a0c" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="400" height="400" fill="url(#avatarBg)" />
  <circle cx="200" cy="180" r="170" fill="none" stroke="url(#redRimLight)" stroke-width="2" />

  <!-- Shoulders & Torso with Plaid Shirt Pattern -->
  <g id="torso">
    <!-- Shirt Body -->
    <path d="M 60 400 L 75 320 Q 120 280, 200 280 Q 280 280, 325 320 L 340 400 Z" fill="url(#plaidPattern)" stroke="#3e2d24" stroke-width="1.5" />

    <!-- Center Placket -->
    <path d="M 188 280 L 188 400 L 212 400 L 212 280 Z" fill="#99816f" stroke="#4a372c" stroke-width="1" />
    <!-- Buttons -->
    <circle cx="200" cy="315" r="4.5" fill="#f4f4f5" stroke="#a1a1aa" stroke-width="1" />
    <circle cx="200" cy="355" r="4.5" fill="#f4f4f5" stroke="#a1a1aa" stroke-width="1" />
    <circle cx="200" cy="395" r="4.5" fill="#f4f4f5" stroke="#a1a1aa" stroke-width="1" />

    <!-- Shirt Collars -->
    <!-- Left Collar (Viewer's Left) -->
    <path d="M 150 268 L 195 282 L 175 328 L 138 286 Z" fill="#b39d8b" stroke="#3b2b22" stroke-width="1.5" />
    <!-- Right Collar (Viewer's Right) -->
    <path d="M 250 268 L 205 282 L 225 328 L 262 286 Z" fill="#a48e7c" stroke="#3b2b22" stroke-width="1.5" />
    
    <!-- Chest V-Opening -->
    <path d="M 186 270 L 200 294 L 214 270 Z" fill="#8c5836" />
  </g>

  <!-- Neck -->
  <g id="neck">
    <path d="M 166 220 L 166 278 Q 200 286, 234 278 L 234 220 Z" fill="url(#neckGrad)" />
    <!-- Adam's Apple & Neck Shadow -->
    <path d="M 194 250 Q 200 255, 206 250" fill="none" stroke="#714227" stroke-width="2" stroke-linecap="round" />
  </g>

  <!-- Head & Ears -->
  <g id="head">
    <!-- Left Ear -->
    <path d="M 124 165 C 115 165, 112 185, 120 205 C 124 212, 128 210, 130 202 Z" fill="#be8560" stroke="#8d5635" stroke-width="1" />
    <path d="M 120 180 Q 124 190, 122 198" fill="none" stroke="#8d5635" stroke-width="1.5" />

    <!-- Right Ear -->
    <path d="M 276 165 C 285 165, 288 185, 280 205 C 276 212, 272 210, 270 202 Z" fill="#b57c57" stroke="#8d5635" stroke-width="1" />
    <path d="M 280 180 Q 276 190, 278 198" fill="none" stroke="#8d5635" stroke-width="1.5" />

    <!-- Face Shape (Jawline & Chin) -->
    <path d="M 128 145 C 128 215, 150 248, 200 248 C 250 248, 272 215, 272 145 C 272 95, 245 80, 200 80 C 155 80, 128 95, 128 145 Z" fill="url(#skinGrad)" />
  </g>

  <!-- Facial Features -->
  <g id="facial-features">
    <!-- Eyebrows -->
    <!-- Left Eyebrow -->
    <path d="M 150 148 Q 170 142, 185 147" fill="none" stroke="#16141a" stroke-width="4.5" stroke-linecap="round" />
    <!-- Right Eyebrow -->
    <path d="M 215 147 Q 230 142, 250 148" fill="none" stroke="#16141a" stroke-width="4.5" stroke-linecap="round" />

    <!-- Eyes -->
    <!-- Left Eye -->
    <path d="M 152 163 Q 168 156, 184 163 Q 168 171, 152 163 Z" fill="#ffffff" />
    <circle cx="168" cy="163" r="5" fill="#181312" />
    <circle cx="169.5" cy="161.5" r="1.5" fill="#ffffff" />
    <path d="M 152 163 Q 168 154, 184 163" fill="none" stroke="#221b18" stroke-width="1.5" />

    <!-- Right Eye -->
    <path d="M 216 163 Q 232 156, 248 163 Q 232 171, 216 163 Z" fill="#ffffff" />
    <circle cx="232" cy="163" r="5" fill="#181312" />
    <circle cx="233.5" cy="161.5" r="1.5" fill="#ffffff" />
    <path d="M 216 163 Q 232 154, 248 163" fill="none" stroke="#221b18" stroke-width="1.5" />

    <!-- Nose -->
    <path d="M 197 160 L 195 190 Q 192 198, 200 199 Q 208 198, 205 190 Z" fill="#b07753" fill-opacity="0.4" />
    <!-- Nose Base & Nostrils -->
    <path d="M 188 194 Q 200 202, 212 194" fill="none" stroke="#7e4a2d" stroke-width="2" stroke-linecap="round" />
    <circle cx="191" cy="194" r="1.8" fill="#5c341d" />
    <circle cx="209" cy="194" r="1.8" fill="#5c341d" />

    <!-- Mustache (Curving, neatly trimmed matching photo) -->
    <path d="M 182 210 Q 194 207, 199 212 Q 200 212, 201 212 Q 206 207, 218 210 Q 212 217, 201 215 Q 199 215, 188 217 Z" fill="#141317" />

    <!-- Lips -->
    <path d="M 186 219 Q 200 223, 214 219" fill="none" stroke="#8d4a3d" stroke-width="2.5" stroke-linecap="round" />
    <path d="M 189 221 Q 200 227, 211 221" fill="none" stroke="#71392f" stroke-width="1.5" stroke-linecap="round" />

    <!-- Beard / Goatee / Jaw Stubble -->
    <!-- Small Soul Patch under lip -->
    <ellipse cx="200" cy="228" rx="4" ry="2.5" fill="#16141a" />
    
    <!-- Chin Beard & Goatee -->
    <path d="M 188 234 Q 200 236, 212 234 Q 216 248, 200 250 Q 184 248, 188 234 Z" fill="#141317" />
    
    <!-- Jawline Beard Trim -->
    <path d="M 132 195 Q 146 226, 186 244 L 188 238 Q 152 222, 140 195 Z" fill="#18161c" fill-opacity="0.85" />
    <path d="M 268 195 Q 254 226, 214 244 L 212 238 Q 248 222, 260 195 Z" fill="#18161c" fill-opacity="0.85" />
  </g>

  <!-- Voluminous Curly Black Hair (Matching the user's uploaded photo) -->
  <g id="curly-hair">
    <!-- Base Hair Volume -->
    <path d="M 124 148 C 114 130, 116 100, 134 82 C 145 70, 165 60, 200 60 C 235 60, 255 70, 266 82 C 284 100, 286 130, 276 148 C 268 120, 262 108, 252 104 C 236 102, 230 114, 212 110 C 196 108, 188 116, 172 112 C 156 114, 148 106, 136 116 C 130 124, 126 136, 124 148 Z" fill="url(#hairGrad)" />

    <!-- Natural Curl Clusters -->
    <!-- Top Crown Curls -->
    <circle cx="160" cy="72" r="14" fill="#1b1a20" />
    <circle cx="185" cy="65" r="15" fill="#151419" />
    <circle cx="210" cy="65" r="16" fill="#1b1a20" />
    <circle cx="235" cy="72" r="14" fill="#151419" />
    
    <!-- Upper Forehead Curl Strands -->
    <circle cx="140" cy="85" r="12" fill="#151419" />
    <circle cx="258" cy="86" r="12" fill="#17161c" />
    <circle cx="170" cy="82" r="13" fill="#201f26" />
    <circle cx="198" cy="78" r="14" fill="#141318" />
    <circle cx="225" cy="82" r="13" fill="#1f1e24" />

    <!-- Forehead Hairline Fringe Curls -->
    <path d="M 138 108 Q 146 96, 158 106 Q 168 98, 182 108 Q 195 98, 208 107 Q 220 98, 234 106 Q 246 96, 256 108 Q 262 115, 258 126 Q 250 116, 240 118 Q 230 112, 218 118 Q 206 112, 194 118 Q 182 112, 170 118 Q 158 112, 148 118 Q 140 116, 138 108 Z" fill="#151418" />

    <!-- Sideburns -->
    <path d="M 126 138 L 132 178 L 136 175 L 130 138 Z" fill="#141318" />
    <path d="M 274 138 L 268 178 L 264 175 L 270 138 Z" fill="#141318" />
  </g>

  <!-- Cyber Tech Hud Accents -->
  <g id="hud-accents">
    <!-- Subtle targeting corner marks -->
    <path d="M 40 60 L 40 40 L 60 40" fill="none" stroke="#ff1f3d" stroke-width="1.5" stroke-opacity="0.7" />
    <path d="M 360 60 L 360 40 L 340 40" fill="none" stroke="#ff1f3d" stroke-width="1.5" stroke-opacity="0.7" />
    <path d="M 40 340 L 40 360 L 60 360" fill="none" stroke="#ff1f3d" stroke-width="1.5" stroke-opacity="0.7" />
    <path d="M 360 340 L 360 360 L 340 360" fill="none" stroke="#ff1f3d" stroke-width="1.5" stroke-opacity="0.7" />
    
    <!-- Code watermark -->
    <text x="32" y="385" fill="#ff1f3d" fill-opacity="0.6" font-family="monospace" font-size="9" font-weight="bold">DEV // THURUPATI_RAJU</text>
  </g>
</svg>
